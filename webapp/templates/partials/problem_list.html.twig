{# problem \App\Entity\ContestProblem #}

{% set current_route = app.request.attributes.get('_route') %}
{% set contest_problemset_add_cid = contest_problemset_add_cid | default(false) %}

<h1 class="mt-4 text-center">
    {{ contest.name | default('Contest') }} problems
    {% if contest and show_contest_problemset %}
        {% if contest.contestProblemsetType is not empty %}
            {% if contest_problemset_add_cid %}
                {% set contest_problemset_url = path(contest_problemset_path, {'cid': contest.externalid}) %}
            {% else %}
                {% set contest_problemset_url = path(contest_problemset_path) %}
            {% endif %}
            <a class="btn btn-secondary" role="button"
               href="{{ contest_problemset_url }}">
                <i class="fas fa-file-{{ contest.contestProblemsetType }}"></i>
                problemset
            </a>
        {% endif %}
        {% if showSamples %}
            <a class="btn btn-secondary" href="{{ path('current_samples_data_zip', {cid: contest.externalid}) }}" title="Contains samples, attachments and statement for all problems.">
                <i class="fas fa-download"></i> samples
            </a>
        {% endif %}
    {% endif %}
</h1>

{% if problems is empty %}
    <div class="alert alert-secondary">No problem texts available at this point.</div>
{% else %}
    <div class="container">
        {% if show_jury_warning is defined and show_jury_warning %}
            <div class="alert alert-warning">
                This is a preview of how the page will look like for teams and the public after the contest has started.
            </div>
        {% endif %}

        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle problem-list"
                   {% if stats is defined %}style="--problem-stats-bins: {{ stats.numBuckets }}"{% endif %}>
                <thead>
                    <tr>
                        {% if teamProblemStatus is defined %}
                            <th scope="col" class="text-center"><span class="visually-hidden">Status</span></th>
                        {% endif %}
                        <th scope="col">#</th>
                        <th scope="col">Problem</th>
                        {% if showLimits %}
                            <th scope="col">Limits</th>
                        {% endif %}
                        <th scope="col">Actions</th>
                        {% if stats is defined %}
                            <th scope="col" class="ps-4">
                                <div class="problem-stats-axis">
                                    <span class="problem-stats-axis-start">{{ stats.start | printtime(null, contest, false) }}</span>
                                    <span class="problem-stats-axis-end">{{ stats.end | printtime(null, contest, false) }}</span>
                                    {% if stats.freezeBucket is not null %}
                                        <span
                                            class="problem-stats-freeze"
                                            style="grid-column: {{ stats.freezeBucket + 1 }}"
                                            data-bs-toggle="tooltip"
                                            data-bs-placement="top"
                                            title="Scoreboard frozen since {{ contest.freezetime | printtime(null, contest, false) }}">
                                            <i class="fas fa-snowflake"></i>
                                        </span>
                                    {% endif %}
                                </div>
                            </th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% set defaultProblemType = contest and contest.scoreboardType.value == 'score' ? 'scoring' : 'pass-fail' %}
                    {% for problem in problems %}
                        {% set probid = problem.problem.probid %}
                        {% set numsamples = samples[problem.probid] %}
                        {% if problem.problem.interactiveProblem %}
                            {% set numsamples = 0 %}
                        {% endif %}
                        <tr>
                            {% if teamProblemStatus is defined %}
                                {% set status = teamProblemStatus[probid] | default(null) %}
                                <td class="text-center text-nowrap problem-status-cell">
                                    {% if status == 'solved' %}
                                        <i class="fas fa-check text-success problem-status-solved" title="Solved"></i>
                                    {% elseif status == 'pending' %}
                                        <i class="fas fa-hourglass-half text-primary problem-status-pending" title="Submission pending"></i>
                                    {% elseif status == 'attempted' %}
                                        <i class="fas fa-times text-danger problem-status-attempted" title="Attempted (not solved)"></i>
                                    {% else %}
                                        <span class="text-body-secondary problem-status-none" title="Not attempted">&mdash;</span>
                                    {% endif %}
                                </td>
                            {% endif %}
                            <td class="text-nowrap">
                                {{ problem | problemBadge }}
                            </td>
                            <td>
                                <span class="fw-semibold problem-name">{{ problem.problem.name }}</span>
                                {% set displayTypes = problem.problem.typeNames | filter(t => t != defaultProblemType) %}
                                {% if displayTypes is not empty %}
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis border ms-1">{{ displayTypes | join(', ') }}</span>
                                {% endif %}
                                {% if problem.problem.languages | length != 0 %}
                                    <span class="ms-1 small text-body-secondary">
                                        ({% for lang in problem.problem.languages %}<code>{{ lang.name }}</code>{% if not loop.last %}, {% endif %}{% endfor %})
                                    </span>
                                {% endif %}
                            </td>
                            {% if showLimits %}
                                <td class="text-nowrap small text-body-secondary problem-limits">
                                    {{ problem.problem.timelimit }}s{% if timeFactorDiffers %}*{% endif %}
                                    /
                                    {{ ((problem.problem.memlimit | default(defaultMemoryLimit)) * 1024) | printSize }}
                                </td>
                            {% endif %}
                            <td class="text-nowrap">
                                <div class="d-inline-flex align-items-center gap-1 flex-wrap">
                                    {% if show_submit_button | default(false) %}
                                        {% if is_granted('ROLE_JURY') or (current_team_contest is not null and current_team_contest.freezeData.started) %}
                                            <a class="btn btn-success btn-sm" data-ajax-modal data-ajax-modal-after="initSubmitModal" href="{{ path('team_submit', {problem: problem.probid}) }}">
                                                <i class="fas fa-cloud-upload-alt"></i> Submit
                                            </a>
                                        {% else %}
                                            <span class="btn btn-success btn-sm disabled" aria-disabled="true">
                                                <i class="fas fa-cloud-upload-alt"></i> Submit
                                            </span>
                                        {% endif %}
                                    {% endif %}

                                    {% if problem.problem.problemstatementType is not empty %}
                                        <a class="btn btn-secondary btn-sm" role="button"
                                           href="{{ path(problem_statement_path, {'probId': problem.externalId}) }}">
                                            <i class="fas fa-file-{{ problem.problem.problemstatementType }}"></i>
                                            statement
                                        </a>
                                    {% endif %}

                                    {% if numsamples > 0 %}
                                        <a class="btn btn-secondary btn-sm" role="button"
                                           href="{{ path(problem_sample_zip_path, {'probId': problem.externalId}) }}">
                                            <i class="fas fa-file-archive"></i> samples
                                        </a>
                                    {% endif %}

                                    {% set clarificationsCount = 0 %}
                                    {% set unseenClarificationCount = 0 %}
                                    {% if clarifications[problem.probid] is defined %}
                                        {% set clarificationsCount = clarifications[problem.probid] | length %}
                                        {% for clar in clarifications[problem.probid] %}
                                            {% if team and team.unreadClarifications.contains(clar) %}
                                                {% set unseenClarificationCount = unseenClarificationCount + 1 %}
                                            {% endif %}
                                        {% endfor %}
                                    {% endif %}
                                    {% if clarificationsCount > 0 %}
                                        <a data-ajax-modal class="btn btn-secondary btn-sm" role="button"
                                           title="Clarifications"
                                           href="{{ path(current_route starts with 'team_' ? 'team_clarification_by_prob' : 'public_clarification_by_prob', {'probId': problem.externalId}) }}">
                                            <i class="fas fa-question-circle"></i>
                                            {% set badgeClass = unseenClarificationCount > 0 ? 'text-bg-danger' : 'text-bg-info' %}
                                            <span class="badge {{ badgeClass }}">{{ clarificationsCount }}</span>
                                            <span class="visually-hidden">clarifications</span>
                                        </a>
                                    {% endif %}
                                </div>
                                {% if problem.problem.attachments | length > 0 %}
                                    <div class="d-flex align-items-center gap-1 flex-wrap mt-1">
                                        {% for attachment in problem.problem.attachments %}
                                            <a class="btn btn-outline-secondary btn-sm" role="button"
                                               href="{{ path(problem_attachment_path, {'probId': problem.externalId, 'attachmentId': attachment.attachmentid}) }}">
                                                <i class="{{ attachment.type | fileTypeIcon }}"></i> {{ attachment.name }}
                                            </a>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </td>
                            {% if stats is defined %}
                                <td class="ps-4">
                                    {% set probMaxCount = 1 %}
                                    {% for bucket in 0..stats.numBuckets - 1 %}
                                        {% set probMaxCount = max(probMaxCount, stats.problems[probid].correct[bucket].count, stats.problems[probid].incorrect[bucket].count) %}
                                    {% endfor %}
                                    <div class="problem-stats">
                                        {% for bucket in 0..stats.numBuckets - 1 %}
                                            {% set correctStat = stats.problems[probid].correct[bucket] %}
                                            {% set incorrectStat = stats.problems[probid].incorrect[bucket] %}
                                            {% set frozen = stats.freezeBucket is not null and bucket >= stats.freezeBucket %}
                                            {% if frozen %}
                                                {% set upCount = correctStat.count %}
                                                {% set downCount = 0 %}
                                                {% set upClass = 'bar-frozen' %}
                                                {% set countText = upCount == 1 ? 'submission' : 'submissions' %}
                                                {% set statsLabel = upCount ~ ' ' ~ countText ~ ' in freeze' %}
                                            {% else %}
                                                {% set upCount = correctStat.count %}
                                                {% set downCount = incorrectStat.count %}
                                                {% set upClass = 'bar-correct' %}
                                                {% set correctText = upCount == 1 ? 'submission' : 'submissions' %}
                                                {% set incorrectText = downCount == 1 ? 'submission' : 'submissions' %}
                                                {% set statsLabel = upCount ~ ' correct ' ~ correctText ~ ', ' ~ downCount ~ ' incorrect ' ~ incorrectText %}
                                            {% endif %}
                                            {% set upPct = upCount > 0 ? min(100, (upCount / probMaxCount * 100) | round) : 0 %}
                                            {% set downPct = downCount > 0 ? min(100, (downCount / probMaxCount * 100) | round) : 0 %}

                                            <div
                                                class="problem-stats-bin"
                                                data-bs-toggle="tooltip"
                                                data-bs-placement="top"
                                                data-bs-html="true"
                                                title="Between {{ correctStat.start.timestamp | printtime(null, contest, false) }} and {{ correctStat.end.timestamp | printtime(null, contest, false) }}:<br/>{{ statsLabel }}">
                                                <div class="problem-stats-half problem-stats-half-up">
                                                    {% if upCount > 0 %}
                                                        <div class="problem-stats-bar {{ upClass }}" style="--bar-height: {{ upPct }}%"></div>
                                                    {% endif %}
                                                </div>
                                                <div class="problem-stats-half problem-stats-half-down">
                                                    {% if downCount > 0 %}
                                                        <div class="problem-stats-bar bar-incorrect" style="--bar-height: {{ downPct }}%"></div>
                                                    {% endif %}
                                                </div>
                                            </div>
                                        {% endfor %}
                                    </div>
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        {% if showLimits and timeFactorDiffers %}
            <div class="row">
                <div class="col-md-12 my-sm-3">
                    <div class=" alert alert-secondary" role="alert">
                        * language time factors apply
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
{% endif %}
