{% extends "jury/base.html.twig" %}
{% form_theme form _self %}

{% block title %}Configuration - {{ parent() }}{% endblock %}

{% block config_key_value_widget %}
    <div class="input-group" id="{{ id }}">
        {{- form_widget(form.key) -}}
        {{- form_widget(form.val) -}}
    </div>
{% endblock %}

{% block content %}
    {% if diffs is not null %}
        {% if diffs %}
            <div class="alert alert-info" role="alert">
                Saved changes:
                <ul>
                    {% for key, change in diffs %}
                        <li>
                            <code>{{ key }}</code>:
                            {{ change.before | json_encode }}
                            ⟶
                            {{ change.after | json_encode }}
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% else %}
            <div class="alert alert-warning" role="alert">
                <p>No changes made, no changes saved.</p>
            </div>
        {% endif %}

    {% endif %}
    <h1>Configuration</h1>

    {{ form_start(form) }}
    <ul class="nav nav-pills nav-fill" id="configtablist" role="tablist">
        {% for category in categories | keys %}
            {% set tabId = category | replace({' ': ''}) %}
            <li class="nav-item" role="presentation">
                <a class="nav-link {{ category == activeCategory ? 'active' }}" id="{{ tabId }}-tab" data-bs-toggle="tab" href="#{{ tabId }}" role="tab">{{ category }}</a>
            </li>
        {% endfor %}
    </ul>

    <div class="tab-content my-2" id="configtab">
        {% for category, names in categories %}
            {% set tabId = category | replace({' ': ''}) %}
            <div class="tab-pane fade {{ category == activeCategory ? 'show active' }}" id="{{ tabId }}" role="tabpanel" aria-labelledby="{{ tabId }}-tab">
                <div class="card">
                    <div class="card-body col-xl-8">
                        {% for name in names %}
                            {{ form_row(form[name], {help: form[name].vars.help | domjudgeMarkdownToHtml, help_html: true}) }}
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
    {{ form_widget(form.save) }}
    {{ form_end(form) }}
{% endblock %}

{% block extrafooter %}
    <script>
        $(function () {
            function addDeleteButton($entry) {
                var $group = $entry.find('.input-group');
                if (!$group.length) {
                    $group = $entry.find(':input').first().wrap('<div class="input-group"></div>').parent();
                }
                $('<button type="button" class="btn btn-outline-danger"><i class="fas fa-trash"></i></button>')
                    .on('click', function () { $entry.remove(); })
                    .appendTo($group);
            }

            $('[data-prototype]').each(function () {
                var holder = this;
                var $holder = $(holder);
                var index = $holder.children().length;
                $holder.children().each(function () { addDeleteButton($(this)); });
                $('<button type="button" class="btn btn-sm btn-outline-secondary mb-3"><i class="fas fa-plus"></i> Add</button>')
                    .on('click', function () {
                        while (document.getElementById(holder.id + '_' + index)) {
                            index++;
                        }
                        var $entry = $($holder.data('prototype').replace(/__name__/g, index++));
                        $holder.append($entry);
                        addDeleteButton($entry);
                    })
                    .insertAfter($holder);
            });
        });
    </script>
{% endblock %}
