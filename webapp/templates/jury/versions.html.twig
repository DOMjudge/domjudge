{% extends "jury/base.html.twig" %}
{% import "jury/jury_macros.twig" as macros %}

{% block title %}Compiler and runner versions overview{% endblock %}

{% block extrahead %}
    {{ parent() }}
    {{ macros.table_extrahead() }}
{% endblock %}

{% macro version_section(type, outputs, canonical_key) %}
    <h2 class="h6">{{ type|capitalize }} version(s)</h2>
    {% if outputs | length > 1 %}
        <div class="alert alert-danger" role="alert">Versions do not match.</div>
    {% endif %}
    {% for key, output in outputs %}
        <div class="card mb-2">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    {% if key == canonical_key %}
                        <span class="badge text-bg-success">Canonical version</span>
                    {% else %}
                        <span class="badge text-bg-danger">Not canonical</span>
                        {% if is_granted('ROLE_ADMIN') %}
                            {{ button(path('jury_' ~ type ~ '_promote', {'versionId': output.versionid}), 'Mark as canonical', 'primary btn-sm', 'bookmark') }}
                        {% endif %}
                    {% endif %}
                </div>
                {% if is_granted('ROLE_ADMIN') %}
                    <form action="{{ path('jury_version_clear', {'versionId': output.versionid, 'type': type}) }}" method="post" class="d-inline"
                          onsubmit="return confirm('Clear this {{ type }} version?');">
                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="fas fa-trash-alt"></i>&nbsp;Clear
                        </button>
                    </form>
                {% endif %}
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item">
                    <div class="terminal-block">
                        <div class="terminal-command">{{ output.command }}</div>
                        <div class="terminal-output">{{ output.version }}</div>
                    </div>
                </li>
                <li class="list-group-item">
                    First reported by
                    <ul>
                        {% for host in output.hostdata %}
                            <li>
                                {{ host.hostname | printHost }}: {{ host.last_changed | printHumanTimeDiff }}
                            </li>
                        {% endfor %}
                    </ul>
                </li>
            </ul>
        </div>
    {% endfor %}
{% endmacro %}

{% block content %}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0">Compiler and runner version overview</h1>
        {% if is_granted('ROLE_ADMIN') and has_active_versions %}
            <form action="{{ path('jury_versions_clear_all') }}" method="post" class="d-inline"
                  onsubmit="return confirm('Clear all reported compiler and runner versions?');">
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash-alt"></i>&nbsp;Clear all versions
                </button>
            </form>
        {% endif %}
    </div>

    {% for lang in data %}
        <div class="card mb-3">
            <div class="card-header">
                Language <code>{{ lang.language.name }}</code>
                {% if is_granted('ROLE_ADMIN') %}
                <span style="float: right">
                    {{ button(path('jury_language_edit', {'langId': lang.language.externalid}), 'Edit version command(s)', 'primary btn-sm', 'edit') }}
                </span>
                {% endif %}
            </div>
            <div class="card-body">
                <div class="card-title">
                    <div class="row">
                        <div class="col-sm">
                            {{ _self.version_section('compiler', lang.compiler_outputs, lang.canonical_compiler_key) }}
                            {% if lang.runner_outputs | length > 0 %}
                                <br/>
                                {{ _self.version_section('runner', lang.runner_outputs, lang.canonical_runner_key) }}
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endfor %}
{% endblock %}
