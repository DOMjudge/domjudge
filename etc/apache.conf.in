# @configure_input@

# Apache configuration for DOMjudge


### VirtualHost config ###
#
# Use this VirtualHost block if you want DOMjudge to live in
# the root of your webserver. See the Apache documentation for
# virtualhosts for more information.

# Using HTTP:

#NameVirtualHost *
#<VirtualHost *>
#ServerName _default_
#DocumentRoot @domserver_webappdir@/public
#</VirtualHost>

# Alternatively, use HTTPS and redirect HTTP to HTTPS:

#Listen 443
#
#<VirtualHost *:80>
#ServerName _default_
#Redirect 308 / https://domjudge.example.com/
#</VirtualHost>
#
# Or block all cleartext HTTP requests:
#
#<VirtualHost *:80>
#ServerName _default_
#Redirect 426 /
#</VirtualHost>
#
#Listen 443
#
#<VirtualHost *:80>
#ServerName _default_
#Redirect 308 / https://domjudge.example.com/
#</VirtualHost>
#
#
#<VirtualHost *:443>
#ServerName _default_
#DocumentRoot @domserver_webappdir@/public
#
# See https://ssl-config.mozilla.org/ to generate good TLS settings for your server
#SSLEngine on
#SSLCertificateFile    /path/to/your/SSL-certificate.crt
#SSLCertificateKeyFile /path/to/your/SSL-key.key
#SSLCertificateChainFile /path/to/your/certificate-chain.pem
#</VirtualHost>


@ONLY_IF_PREFIX@### Alias config ###
@ONLY_IF_ROOT@### Document root config ###
#
# The directives below are derived from the configured base URL.
@ONLY_IF_NAMED@# This is a named instance, so it gets a VirtualHost for the
@ONLY_IF_NAMED@# host in its base URL. That lets several instances coexist in
@ONLY_IF_NAMED@# one Apache; install this file as a site, not as a conf, so
@ONLY_IF_NAMED@# that it does not become the default VirtualHost.
@ONLY_IF_LISTEN@#
@ONLY_IF_LISTEN@# Apache does not listen on the port in the base URL by default.
@ONLY_IF_LISTEN@# Several instances may share it, but a duplicate Listen makes
@ONLY_IF_LISTEN@# Apache refuse to start, so only the first one declares it.
@ONLY_IF_LISTEN@<IfDefine !DOMJUDGE_LISTEN_@URLLISTEN@>
@ONLY_IF_LISTEN@Define DOMJUDGE_LISTEN_@URLLISTEN@
@ONLY_IF_LISTEN@Listen @URLLISTEN@
@ONLY_IF_LISTEN@</IfDefine>
@ONLY_IF_NAMED@<VirtualHost *:@URLLISTEN@>
@ONLY_IF_NAMED@ServerName @URLSERVERNAME@
@ONLY_IF_PREFIX@# The base URL does not put DOMjudge in the root of this
@ONLY_IF_PREFIX@# server, but only lets it occupy a subdir, like this:
@ONLY_IF_PREFIX@@ONLY_IF_DEFAULT@# www.example.com/domjudge. Use one of the VirtualHost
@ONLY_IF_PREFIX@@ONLY_IF_DEFAULT@# blocks above instead to give it a server of its own.
@ONLY_IF_PREFIX@@ONLY_IF_NAMED@# www.example.com/domjudge.
@ONLY_IF_PREFIX@Alias @URLPREFIX@ @domserver_webappdir@/public
@ONLY_IF_ROOT@# The base URL puts DOMjudge in the root of this server, so
@ONLY_IF_ROOT@# it takes over the document root rather than occupying a
@ONLY_IF_ROOT@@ONLY_IF_DEFAULT@# subdirectory. Note that this applies to the whole server;
@ONLY_IF_ROOT@@ONLY_IF_DEFAULT@# move it into one of the VirtualHost blocks shown above if
@ONLY_IF_ROOT@@ONLY_IF_DEFAULT@# that is not what you want.
@ONLY_IF_ROOT@@ONLY_IF_NAMED@# subdirectory.
@ONLY_IF_ROOT@DocumentRoot @domserver_webappdir@/public
@ONLY_IF_NAMED@</VirtualHost>

### General options ###
#
# This section applies to both options above.

<Directory @domserver_webappdir@/public>
Require all granted

Options -MultiViews
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.*)$ index.php [QSA,L]

RewriteRule .git/ - [F]
RewriteRule .gitignore$ - [F]
RewriteRule Makefile$ - [F]

<IfModule headers_module>
    # Strict-Transport-Security is not set by default since it will break
    # installations without a valid TLS certificate. Enable it if your
    # DOMjudge installation only runs with a valid TLS certificate.
    #Header set Strict-Transport-Security "max-age=31556952"

    # The X-Frame-Options header defends against so-called 'clickjacking' attacks.
    # Should you want to load part of DOMjudge (e.g. the public scoreboard) in
    # a HTML frame or iframe, disable this header for that part of DOMjudge only.
    Header set X-Frame-Options "DENY"

    # The following headers should be fine for any DOMjudge installation.
    Header set Referrer-Policy "same-origin"
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

</Directory>

<Directory @domserver_webappdir@/public/bundles>
    RewriteEngine Off
</Directory>

<IfModule proxy_fcgi_module>
    # Configure the Apache FastCGI proxy module to flush chunks of data after
    # 500ms even if the buffer is not full. This prevents delayed events and
    # half-flushed event objects in a streaming event feed.
    # Related: https://svn.apache.org/viewvc?view=revision&revision=1802040
    <Proxy "fcgi://localhost">
        ProxySet flushpackets=auto
        ProxySet flushwait=500
    </Proxy>
</IfModule>

# When running a proxy or loadbalancer in front of this apache instance,
# you can use these directives to trust the proxy / loadbalancer and let
# this apache instance use the correct client IP. Note that if you use a
# virtual host, these directives can also be placed inside the
# VirtualHost block

# The header to get the client IP from
# RemoteIPHeader X-Forwarded-For
# The IP address of the proxy / loadbalancer. Use this directive multiple
# times if you need to use more than one IP address
# RemoteIPInternalProxy 1.2.3.4

# vim: syntax=apachestyle
# Local Variables:
# mode: apache
# end:
