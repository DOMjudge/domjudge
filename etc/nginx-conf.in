# @configure_input@

# nginx configuration for DOMjudge

### upstream ###
#
# always include this and make sure it points to the socket of PHP-FPM
# The upstream is named after the instance, since its name is global to
# nginx and a duplicate makes nginx refuse to start.
upstream @INSTANCE@ {
	server unix:/var/run/php-fpm-@INSTANCE@.sock; # if using with etc/domjudge-fpm.conf
	#server unix:/run/php/php7.0-fpm.sock; # default on ubuntu servers
}

# Read the HTTPS field from the X-Forwarded-Proto field from any upstream proxy
# Fall back to the internal $https variable if not set
# This variable is global to nginx too, hence the instance name in it.
map $http_x_forwarded_proto $@HTTPSVAR@ {
	default $https;
	https 'on';
}

### http host config ###
#

server {
	listen @URLLISTEN@;
	listen [::]:@URLLISTEN@;

	# If you are reading from the event feed, make sure this is large enough.
	# If you have a slow event feed reader, nginx needs to keep the connection
	# open long enough between two write operations
	send_timeout 36000s;
	include @domserver_etcdir@/nginx-conf-inner;
}

# Alternatively, use HTTPS and redirect HTTP to HTTPS:

# server {
# 	listen   80;
# 	listen   [::]:80;
# 	server_name @URLSERVERNAME@;
# 	return 308 https://$host$request_uri;  # enforce https
# }

